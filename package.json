{
  "name": "@prjct.app/pi-tui-kit",
  "version": "0.0.0-development",
  "description": "One minimal, actionable TUI for every prjct Pi extension: a docked list/detail panel with one-key actions, and one line for active modes.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "terminal",
    "tui",
    "design-system"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepack": "npm run build",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-tui-kit.git"
  },
  "homepage": "https://github.com/prjct-app/pi-tui-kit#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-tui-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
